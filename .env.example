# TESTNET PACKAGE: Binance Spot Testnet only. No real-money orders.
BOT_PRODUCT=BINANA
BOT_ENVIRONMENT=TESTNET
BOT_INSTANCE_ID=BINANA-TN-TYO-01
BOT_NAMESPACE=binana-testnet
EXECUTION_MODE=testnet
# Installer capacity policy. Alternate single-bot-testnet-experiment is opt-in,
# TestNet-only, and refuses coexistence with another running Compose project.
DEPLOYMENT_PROFILE=four-bot-oracle
# Transport only: set false for the documented REST candle experiment after
# a host rejects Freqtrade market WebSockets. Does not alter any indicator.
FREQTRADE_ENABLE_WS=true
DISK_CRITICAL_PERCENT=90
# Oracle defaults. oracle_setup.sh prints the dedicated binanabot UID/GID;
# replace these two placeholders with those exact numeric values.
SHARED_HOST_PATH=/var/lib/binana-testnet/shared
BOT_UID=REPLACE_WITH_BINANATN_UID
BOT_GID=REPLACE_WITH_BINANATN_GID
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Owner-only Telegram broker. Keep these only in /opt/.../.env on Oracle (chmod 600).
TELEGRAM_BOT_TOKEN=REPLACE_WITH_REAL_TELEGRAM_TOKEN
TELEGRAM_OWNER_CHAT_ID=REPLACE_WITH_NUMERIC_OWNER_ID
CALLBACK_TTL_SECONDS=120
COMMAND_MAX_AGE_SECONDS=120
COMMAND_RESULT_MAX_FILES=1000
COMMAND_RESULT_MAX_AGE_SECONDS=86400
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUPS=5
SIGNAL_ARCHIVE_MAX_FILES=10000
UNIVERSE_SNAPSHOT_MAX_FILES=10000

# Internal-only Freqtrade REST API used by the single Telegram broker.
FREQTRADE_API_USERNAME=freqtrade
FREQTRADE_API_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
FREQTRADE_API_JWT_SECRET=GENERATE_AT_LEAST_64_RANDOM_CHARACTERS
FREQTRADE_API_WS_TOKEN=GENERATE_AT_LEAST_64_RANDOM_CHARACTERS

# HMAC keys authenticating the inter-service file buses (V101-NEW-001).
# Generate each as >= 32 random characters, e.g. python -c "import secrets;print(secrets.token_hex(24))".
# Each producer holds only the key(s) it needs; all are required for a running stack.
SIGNAL_HMAC_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
COMMAND_HMAC_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
SHARIA_HMAC_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
SHARIA_APPROVAL_HMAC_KEY=GENERATE_A_DIFFERENT_32_RANDOM_CHARACTERS
# Separate result transport key plus Ed25519 attestation keys.  Mount the
# private key into sharia-screener only; every consumer gets public-only DER.
SHARIA_RESULT_HMAC_KEY=GENERATE_A_DIFFERENT_32_RANDOM_CHARACTERS
SHARIA_RESULT_SIGNING_PRIVATE_KEY_B64=BASE64_PKCS8_DER_ED25519_PRIVATE_KEY
SHARIA_RESULT_VERIFY_PUBLIC_KEY_B64=BASE64_SPKI_DER_ED25519_PUBLIC_KEY
# Only needed to promote to live; leave blank for simulation/testnet.
LIVE_EVIDENCE_KEY=

# The bot never buys or depends on BNB. Binance decides the actual commission asset per fill.
TRADE_SIZE_USDT=100
MAX_POSITIONS=2
AUTO_CONFIRM=false

# Reproducible top-50 service. Only explicit, current V19.1 GREEN records can pass.
UNIVERSE_LIMIT=50
UNIVERSE_REFRESH_SECONDS=900
MAX_UNIVERSE_AGE_SECONDS=1800
MIN_LISTING_AGE_DAYS=30
MIN_QUOTE_VOLUME_USDT=1000000
MAX_SPREAD_RATIO=0.005

# ── Official Binance Spot microstructure (public, free, no API key) ──
# This is SHADOW/ADVISORY evidence. It never approves/rejects signals, changes
# strategy thresholds, sizes orders, or alters execution. The immutable package
# mode binds TestNet to Binance's official market-data-only production host,
# matching the production Spot data observed by its dry-run signal engine.
ENABLE_SPOT_MICROSTRUCTURE=true
BINANCE_SPOT_MARKET_STREAM=wss://data-stream.binance.vision/ws
MARKET_CONTEXT_PUBLISH_SECONDS=5
MARKET_CONTEXT_UNIVERSE_POLL_SECONDS=15
MARKET_CONTEXT_MAX_AGE_MS=15000
MARKET_CONTEXT_EVIDENCE_MAX_AGE_SECONDS=30
CAPTURE_SIGNAL_MARKET_CONTEXT=true
MARKET_CONTEXT_SIGNAL_EVIDENCE_MAX_FILES=10000
# Proactively rotate before Binance's documented 24-hour connection lifetime.
MARKET_CONTEXT_ROTATION_SECONDS=82200
SHARIA_FILE=/app/shared/sharia/sharia_status.json
LEGACY_HALAL_FILE=/app/shared/sharia/halal_coins.json
UNIVERSE_FILE=/app/shared/universe/current_pairlist.json
SIGNAL_INBOX=/app/shared/signals/inbox
LEGACY_RUNTIME_DIR=/app/shared/legacy_runtime

# ── External market signals: CoinGecko + CoinMarketCap (V10.2-EXT-001) ──
# ADVISORY ONLY: annotates the universe snapshot and can optionally exclude
# coins below a market-cap floor. Never reorders ranking, never adds coins,
# and fails open to Binance-only scanning on any provider problem.
# Both features ship DISABLED so the default behavior is unchanged.
ENABLE_COINGECKO_SIGNALS=false
ENABLE_CMC_TRENDING=false
# CoinGecko free Demo key: https://www.coingecko.com/en/developers/dashboard
# Keyless works but is clamped to 5 calls/min (shared-IP allowance on Oracle).
COINGECKO_API_KEY=
# CoinMarketCap free Basic key: https://pro.coinmarketcap.com/signup
# (COINMARKETCAP_API_KEY and CMC_API_KEY are both accepted, audit M-04.)
COINMARKETCAP_API_KEY=
# Refresh cadence for external data (seconds, min 300). At the default
# 30-minute cadence, worst-case scheduled usage is about 4,464 CoinGecko
# calls/month (~93% of its 4,800 process partition) and about 1,488 CMC
# credits/month (~13.1% of its 11,400 process partition), before failures,
# retries, or provider-side billing changes. See docs/EXTERNAL_SIGNALS.md.
EXTERNAL_SIGNALS_REFRESH_SECONDS=1800
# 0 disables the optional market-cap floor. The floor is cross-verified:
# it rejects a coin ONLY when CoinGecko AND CMC are both enabled and BOTH
# independently report a known cap below the floor (stable provider ids,
# ambiguous ticker symbols excluded). Unknown coins, single-provider data,
# conflicts, and provider outages NEVER reject.
EXTERNAL_MIN_MARKET_CAP_USD=0
# How many top 24h movers from CMC's listing count as "trending" metadata.
CMC_TRENDING_LIMIT=20
# Free-tier rate budgets. The values below are HARD SAFETY CEILINGS set 4%
# UNDER the documented quotas (verified 2026-07-22; docs/EXTERNAL_SIGNALS.md):
#   CoinGecko Demo: 100 calls/min, 10,000 credits/month -> ceiling 96 / 9600
#   CMC Basic:       50 calls/min, 15,000 credits/month -> ceiling 48 / 14400
# Configuration may LOWER these, never raise them: values above a ceiling
# are clamped to the ceiling, so no configuration path can reach 100% of a
# provider quota. Counters, minute windows, and breaker cool-downs persist
# across restarts in shared/universe/external/; corrupted counter state
# fails CLOSED (provider blocked) rather than resetting usage to zero.
# Aggregate partitions shared with automatic Sharia source discovery. The
# guarded screener refuses startup if enabled processes exceed the plan-wide
# 96/9600 CoinGecko or 48/14400 CMC safety ceilings.
COINGECKO_PER_MINUTE_LIMIT=84
COINGECKO_MONTHLY_LIMIT=4800
CMC_PER_MINUTE_LIMIT=42
CMC_MONTHLY_LIMIT=11400
# Circuit-breaker cool-down after repeated provider failures (seconds).
EXTERNAL_BREAKER_COOLDOWN_SECONDS=900
# How often the CMC monthly ledger reconciles with the provider's own
# /v1/key/info usage figure (seconds, 3600-604800). Reconciliation only
# ever raises the local count, except as the sanctioned recovery from a
# quarantined (corrupt) ledger.
CMC_RECONCILE_SECONDS=21600

# The owner-maintained halal_coins.json registry is the only active Sharia
# approval source. The default package performs no automatic Sharia research,
# accepts no automatic-scanner settings and never uses provider keys to change
# the trading allowlist. Invalid, missing or stale registry state denies entry.
# Exact public contract used by the authenticated TestNet execution sidecar.
# Keep separate from BINANCE_PUBLIC_BASE, which supports production public
# universe/market observations without credentials.
BINANCE_EXECUTION_PUBLIC_BASE=https://testnet.binance.vision
# The signed manual-registry projection is checked before every order. No
# network scan or automatic registry update is performed in the trading path.
SHARIA_SIGNAL_GATE_MODE=cached
SIGNAL_SCREENING_TIMEOUT_SECONDS=150

# Fresh-signal and loss guards.
MAX_SIGNAL_AGE_SECONDS=180
MAX_CANDLE_AGE_SECONDS=180
PAIR_COOLDOWN_SECONDS=60
MAX_STOPOUTS_PER_PAIR_DAY=3
MAX_STOPOUTS_GLOBAL_DAY=10

# Verified SQLite backups (H-006).
SQLITE_BACKUP_INTERVAL_SECONDS=86400
SQLITE_BACKUP_RETAIN=14

# Controlled live promotion only. Must match shared/runtime/SIDECAR_LIVE_OK and a
# signed shared/runtime/LIVE_EVIDENCE.json envelope (C-003/H-007).
SIDECAR_RELEASE_HASH=
RELEASE_TAG=local
LOG_LEVEL=INFO

# Shared Oracle target: Ubuntu 24.04 ARM64, at least 2 OCPUs, 12 GiB RAM,
# 4 GiB swap, and 80 GiB FREE on the root filesystem (use a larger boot
# volume, such as 100 GiB, so the free-space gate can actually pass).
MIN_CPU_COUNT=2
MIN_PHYSICAL_MEMORY_MIB=11264
MIN_TOTAL_MEMORY_MIB=14336
