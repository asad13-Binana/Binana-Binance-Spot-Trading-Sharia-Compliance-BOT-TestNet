FROM freqtradeorg/freqtrade:2026.9@sha256:989aff5636d8f0213ed44fe334c3314a194a51c0c755d16866960247aafd2eae

USER root
ARG BOT_UID=1000
ARG BOT_GID=1000
RUN set -eux; \
    uid_owner="$(getent passwd "$BOT_UID" | cut -d: -f1 || true)"; \
    gid_owner="$(getent group "$BOT_GID" | cut -d: -f1 || true)"; \
    [ -z "$uid_owner" ] || [ "$uid_owner" = ftuser ]; \
    [ -z "$gid_owner" ] || [ "$gid_owner" = ftuser ]; \
    current_uid="$(id -u ftuser)"; \
    current_gid="$(id -g ftuser)"; \
    if [ "$BOT_GID" != "$current_gid" ]; then groupmod -g "$BOT_GID" ftuser; fi; \
    if [ "$BOT_UID" != "$current_uid" ]; then usermod -u "$BOT_UID" ftuser; fi; \
    usermod -g "$BOT_GID" ftuser; \
    chown -R "$BOT_UID:$BOT_GID" /home/ftuser /freqtrade/user_data
USER ftuser
