# GITHUB-002: re-include release-manifest files that the broad ignores above
# would otherwise exclude.
#
# RELEASE_MANIFEST.json tracks these 10 files, so scripts/verify_manifest.py
# fails with "manifest lists missing file" if git does not commit them. In
# .gitignore the LAST matching pattern wins, so these negations must stay at
# the end of the file. Note also that a file cannot be re-included if its
# PARENT DIRECTORY is excluded, which is why 'legacy_core/logs/' above was
# changed to 'legacy_core/logs/*' (contents, not the directory itself).
#
# Runtime output in these directories stays ignored; only the committed
# release evidence and directory placeholders are re-included.
!legacy_core/logs/backtest_results_selftest.json
!legacy_core/logs/passed_partial_fill_test.flag
!legacy_core/logs/passed_rsi_tests.flag
!legacy_core/logs/passed_vwap_uncap_test.flag
!shared/audit/.gitkeep
!shared/runtime/.gitkeep
!shared/signals/inbox/.gitkeep
!shared/signals/processed/.gitkeep
!shared/signals/rejected/.gitkeep
!shared/universe/snapshots/.gitkeep
