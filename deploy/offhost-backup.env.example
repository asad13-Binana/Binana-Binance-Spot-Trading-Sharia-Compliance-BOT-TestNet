# Copy to /etc/binana-testnet/offhost-backup.env as root:root mode 0600.
# The age private identity must remain offline and must never be placed on this VM.
OFFHOST_BACKUP_ENABLED=false
OFFHOST_PROVIDER=oci
OCI_NAMESPACE=replace_with_tenancy_namespace
OCI_BUCKET=replace_with_private_bucket_name
OCI_OBJECT_PREFIX=binana-testnet
AGE_RECIPIENT=replace_with_age_public_recipient
# Optional AWS experiment: OFFHOST_PROVIDER=aws-s3 with EC2 instance role only.
# Existing private bucket and least-privilege IAM are provisioned by the owner.
# AWS_REGION=ap-northeast-1
# AWS_S3_BUCKET=your-private-bucket
# AWS_BUCKET_OWNER=123456789012
# AWS_OBJECT_PREFIX=binana-testnet
