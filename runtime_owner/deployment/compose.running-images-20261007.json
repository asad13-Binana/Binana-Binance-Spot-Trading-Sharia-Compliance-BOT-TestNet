      "init": true,
      "cap_drop": [
        "ALL"
      ],
      "volumes": [
        "/var/lib/binana-testnet/shared:/freqtrade/shared:ro",
        "/var/lib/binana-testnet/shared/freqtrade:/freqtrade/shared/freqtrade:rw",
        "/etc/binana-testnet/release:/freqtrade/binana-release:ro"
      ]
    },
    "telegram-broker": {
