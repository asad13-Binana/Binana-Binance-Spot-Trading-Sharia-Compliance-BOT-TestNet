# Independent of every retained AWS image. Build only the allowlisted context
# emitted by materialize_clean_context.py, never the repository root.
FROM python:3.14.10-slim-trixie@sha256:3cabfd7d7aaf394e6040e79fa1eec6ca1c52b74ed9188650472695d9a9326999
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 PYTHONFAULTHANDLER=1 \
    OPENBLAS_NUM_THREADS=1 HOME=/home/ftuser FT_APP_ENV=docker
# Keep the immutable base and explicitly replace its fixable Debian packages.
# These versions are published for both amd64 and arm64 by Debian security.
# Disable retries while upgrading the base's vulnerable APT (CVE-2026-109518).
RUN apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y --no-install-recommends \
        apt=3.0.4 libapt-pkg7.0=3.0.4 zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 \
        libgomp1 ca-certificates=20250419+deb13u1 liblzma5=5.8.1-1+deb13u2 \
        libpcre2-8-0=10.46-1~deb13u3 libssl3t64=3.5.7-1~deb13u3 \
        openssl=3.5.7-1~deb13u3 openssl-provider-legacy=3.5.7-1~deb13u3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 987 binana \
    && useradd --uid 999 --gid 987 --home-dir /home/ftuser --no-create-home --shell /usr/sbin/nologin binana \
    && mkdir -p /home/ftuser/.local/bin /freqtrade/user_data \
    && chown -R 999:987 /home/ftuser /freqtrade
WORKDIR /freqtrade
COPY requirements.build.lock requirements.owner.lock /tmp/
RUN python -m pip install --no-cache-dir --no-deps --require-hashes --only-binary=:all: -r /tmp/requirements.build.lock \
    && python -m pip install --no-cache-dir --no-deps --require-hashes --no-build-isolation -r /tmp/requirements.owner.lock
COPY upstream/ /freqtrade/
COPY owner/freqtrade/ /freqtrade/freqtrade/
COPY owner/binana-strategies/ /freqtrade/binana-strategies/
RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation ./ft_client . \
    && python -m pip check \
    && ln -s /usr/local/bin/freqtrade /home/ftuser/.local/bin/freqtrade
COPY tests/ /freqtrade/binana_tests/
COPY runtime-fixes/ /freqtrade/runtime-fixes/
COPY PROVENANCE.json validate_image.py release_authority.py CLEAN_SOURCE.json /freqtrade/recovery_validation/
USER 999:987
ENTRYPOINT ["python", "/freqtrade/recovery_validation/validate_image.py"]
CMD []
