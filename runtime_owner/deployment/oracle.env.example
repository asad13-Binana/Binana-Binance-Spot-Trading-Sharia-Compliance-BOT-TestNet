# Copy outside the immutable bundle; chmod 600. Never commit real values.
# These are Linux HOST paths. They must exist; Compose may not create them.
BINANA_STATE_DIR=/var/lib/binana-oracle-testnet/shared
BINANA_CONFIG_DIR=/etc/binana-oracle-testnet/config
BINANA_RELEASE_DIR=/etc/binana-oracle-testnet/release
BOT_INSTANCE_ID=BINANA-TN-OCI-01
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
FREQTRADE_API_USERNAME=binana
FREQTRADE_API_PASSWORD=
FREQTRADE_API_JWT_SECRET=
FREQTRADE_API_WS_TOKEN=
SIGNAL_HMAC_KEY=
COMMAND_HMAC_KEY=
SHARIA_HMAC_KEY=
SHARIA_APPROVAL_HMAC_KEY=
SHARIA_RESULT_HMAC_KEY=
SHARIA_RESULT_SIGNING_PRIVATE_KEY_B64=
SHARIA_RESULT_VERIFY_PUBLIC_KEY_B64=
# 0 means all eligible pairs, preserving the approved October owner policy.
# This never bypasses Sharia, freshness, liquidity or 4-slot limits.
UNIVERSE_LIMIT=0
# Enable only with the explicit Compose research profile and prepared private
# research directories/source registry. Telegram refuses unavailable work.
BINANA_RESEARCH_ENABLED=false
# Optional advisory inputs. Provider failure cannot authorize an entry.
ENABLE_COINGECKO_SIGNALS=false
ENABLE_CMC_TRENDING=false
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
