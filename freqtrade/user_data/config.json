{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 4,
  "stake_currency": "USDT",
  "stake_amount": 250,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "spot",
  "timeframe": "5m",
  "unfilledtimeout": {
    "entry": 5,
    "exit": 3,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      ".*\\/USDT"
    ],
    "pair_blacklist": [
      "BTC/USDT",
      "BNB/USDT",
      ".*(UP|DOWN|BULL|BEAR)/USDT"
    ]
  },
  "pairlists": [
    {
      "method": "RemotePairList",
      "mode": "whitelist",
      "processing_mode": "filter",
      "pairlist_url": "file:///freqtrade/shared/universe/current_pairlist.json",
      "number_assets": 50,
      "refresh_period": 60,
      "keep_pairlist_on_failure": true,
      "read_timeout": 10
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "CHANGE_ME_VIA_ENV_64_CHARS_MINIMUM",
    "ws_token": "CHANGE_ME_VIA_ENV_64_CHARS_MINIMUM",
    "CORS_origins": [],
    "username": "freqtrade",
    "password": "CHANGE_ME_VIA_ENV"
  },
  "bot_name": "ict_smc_signal_engine",
  "initial_state": "running",
  "force_entry_enable": false,
  "margin_mode": "",
  "position_adjustment_enable": false,
  "internals": {
    "process_throttle_secs": 5
  },
  "binana": {
    "enabled": true,
    "environment": "testnet",
    "spot_only": true,
    "allow_live": false,
    "single_halal_decision": true,
    "allocation_usdt": 1000,
    "testnet_epoch_id": "testnet-2026-08-10"
  },
  "db_url": "sqlite:////freqtrade/shared/freqtrade/tradesv3.signal-only.sqlite"
}
