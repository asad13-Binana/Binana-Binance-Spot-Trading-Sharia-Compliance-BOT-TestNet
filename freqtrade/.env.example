# Copy to .env and fill in. NEVER commit .env to GitHub (.gitignore excludes it).
# Freqtrade reads these as config overrides (double-underscore nesting).

# Binance API key — create on a DEDICATED SUB-ACCOUNT:
#   Enable Spot trading ONLY. Disable withdrawals. Restrict to your Oracle server IP.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Telegram bot (from @BotFather) + your numeric chat id
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# Only needed if you enable the web UI (api_server) in user_data/config.json
FREQTRADE__API_SERVER__PASSWORD=
