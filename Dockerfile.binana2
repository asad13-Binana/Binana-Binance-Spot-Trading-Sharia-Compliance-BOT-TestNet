FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN useradd --system --uid 10001 --create-home --home-dir /app binana
WORKDIR /app

COPY requirements-binana2.txt /app/requirements-binana2.txt
RUN pip install --no-cache-dir -r /app/requirements-binana2.txt
COPY binana2 /app/binana2
RUN mkdir -p /app/data && chown -R binana:binana /app

USER binana
VOLUME ["/app/data"]
CMD ["python", "-m", "binana2.app.main"]
