# Binana 2.0 starts fail-closed on Binance Spot Testnet.
BOT_ENVIRONMENT=TESTNET
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW_MS=5000

BINANA_DB_PATH=/app/data/binana.sqlite3
SHARIA_FILE=/app/data/sharia_status.json

# Entry enablement is a two-key concept: this process-level switch plus the
# durable SQLite global_entry_pause. A fresh database starts paused regardless.
ENTRIES_ENABLED=false
TRADE_SIZE_USDT=100
MAX_POSITIONS=2
MAX_SIGNAL_AGE_SECONDS=180
MAX_CANDLE_AGE_SECONDS=180
PAIR_COOLDOWN_SECONDS=60
MAX_STOPOUTS_PER_PAIR_DAY=3
MAX_STOPOUTS_GLOBAL_DAY=10

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
