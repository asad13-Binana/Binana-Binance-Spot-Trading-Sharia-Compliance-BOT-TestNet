[Unit]
Description=Sanitized Docker status snapshot for the BINANA read-only monitor
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=BINANA_COMPOSE_PROJECT=binana-freqtrade-v101
Environment=BINANA_CONTAINER_STATUS_PATH=/var/lib/binana-freqtrade-v101/shared/runtime/container_status.json
ExecStart=/usr/local/libexec/binana-monitor-snapshot --output /var/lib/binana-freqtrade-v101/shared/runtime/container_status.json
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/binana-freqtrade-v101/shared/runtime
ReadWritePaths=-/var/lib/binana-freqtrade-v101/shared/sharia
ReadWritePaths=-/var/lib/binana-freqtrade-v101/shared/universe
ReadWritePaths=-/var/lib/binana-freqtrade-v101/shared/freqtrade
ReadWritePaths=-/var/lib/binana-freqtrade-v101/shared/legacy_runtime/logs
ReadWritePaths=-/var/lib/binana-freqtrade-v101/shared/audit
ReadOnlyPaths=/var/run/docker.sock /usr/bin/docker
