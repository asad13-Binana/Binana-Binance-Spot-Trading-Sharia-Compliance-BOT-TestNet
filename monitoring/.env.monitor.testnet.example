# MONITORING-ONLY environment. Never place Binance/trading credentials here.
# Installed at /etc/binana-testnet/testnet-monitor.env (root:binanatnmon 0640).
BOT_PRODUCT=BINANA
BOT_ENVIRONMENT=TESTNET
BOT_INSTANCE_ID=BINANA-TN-TYO-01
MONITOR_ENABLED=true
MONITOR_BIND_HOST=127.0.0.1
MONITOR_PORT=8090
MONITOR_TOKEN=replace_on_oracle_only
MONITOR_ALLOWED_IPS=127.0.0.1/32,::1/128
MONITOR_RATE_LIMIT_PER_MINUTE=30
MONITOR_ENABLE_DOCS=false
MONITOR_AUDIT_LOG=/var/log/binana-testnet/monitor/testnet-audit.jsonl

BOT_MODE=testnet
BOT_DIRECTORY=/opt/binana-testnet/current
MONITOR_SHARED_ROOT=/var/lib/binana-testnet/shared
EXECUTION_DATABASE_PATH=/var/lib/binana-testnet/shared/runtime/execution_state.sqlite
EXECUTION_PNL_LEDGER_PATH=/var/lib/binana-testnet/shared/legacy_runtime/logs/pnl_ledger.jsonl
SIGNAL_DATABASE_PATH=/var/lib/binana-testnet/shared/freqtrade/tradesv3.signal-only.sqlite
FT_LOG_PATH=/var/lib/binana-testnet/shared/freqtrade/logs/freqtrade.log
SHARIA_STATUS_PATH=/var/lib/binana-testnet/shared/sharia/sharia_status.json
SHARIA_HEALTH_PATH=/var/lib/binana-testnet/shared/runtime/sharia_screener/health.json
DEPLOY_STATUS_PATH=/var/lib/binana-testnet/shared/runtime/deployment_status.json
VALIDATION_STATUS_PATH=/var/lib/binana-testnet/shared/runtime/release_validation.json
OFFHOST_BACKUP_STATUS_PATH=/var/lib/binana-testnet/shared/runtime/offhost_backup_status.json
CONTAINER_STATUS_PATH=/var/lib/binana-testnet/shared/runtime/container_status.json
USER_STREAM_HEALTH_PATH=/var/lib/binana-testnet/shared/runtime/user_stream_health.json
MARKET_CONTEXT_HEALTH_PATH=/var/lib/binana-testnet/shared/runtime/market_context/health.json
MARKET_CONTEXT_PATH=/var/lib/binana-testnet/shared/market_context/current.json
BINANCE_REST_BASE=https://testnet.binance.vision

TELEGRAM_REPORTS_ENABLED=false
TELEGRAM_MONITOR_BOT_TOKEN=replace_on_oracle_only
TELEGRAM_MONITOR_CHAT_ID=replace_on_oracle_only
MONITOR_URL=http://127.0.0.1:8090
