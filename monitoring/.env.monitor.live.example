# MONITORING-ONLY environment. Never place Binance/trading credentials here.
# LIVE monitoring is disabled until formal promotion of the exact release hash.
# Installed at /etc/binana-freqtrade-v101/live-monitor.env (root:botmon 0640).
BOT_PRODUCT=BINANA
BOT_ENVIRONMENT=LIVE
BOT_INSTANCE_ID=BINANA-LIVE-TYO-01
MONITOR_ENABLED=false
MONITOR_BIND_HOST=127.0.0.1
MONITOR_PORT=8090
MONITOR_TOKEN=replace_on_oracle_only
MONITOR_ALLOWED_IPS=127.0.0.1/32,::1/128
MONITOR_RATE_LIMIT_PER_MINUTE=30
MONITOR_ENABLE_DOCS=false
MONITOR_AUDIT_LOG=/var/log/binana-freqtrade-v101/monitor/live-audit.jsonl

BOT_MODE=live
BOT_DIRECTORY=/opt/binana-freqtrade-v101/current
MONITOR_SHARED_ROOT=/var/lib/binana-freqtrade-v101/shared
EXECUTION_DATABASE_PATH=/var/lib/binana-freqtrade-v101/shared/runtime/execution_state.sqlite
EXECUTION_PNL_LEDGER_PATH=/var/lib/binana-freqtrade-v101/shared/legacy_runtime/logs/pnl_ledger.jsonl
SIGNAL_DATABASE_PATH=/var/lib/binana-freqtrade-v101/shared/freqtrade/tradesv3.signal-only.sqlite
FT_LOG_PATH=/var/lib/binana-freqtrade-v101/shared/freqtrade/logs/freqtrade.log
SHARIA_STATUS_PATH=/var/lib/binana-freqtrade-v101/shared/sharia/sharia_status.json
SHARIA_HEALTH_PATH=/var/lib/binana-freqtrade-v101/shared/runtime/sharia_screener/health.json
DEPLOY_STATUS_PATH=/var/lib/binana-freqtrade-v101/shared/runtime/deployment_status.json
VALIDATION_STATUS_PATH=/var/lib/binana-freqtrade-v101/shared/runtime/release_validation.json
CONTAINER_STATUS_PATH=/var/lib/binana-freqtrade-v101/shared/runtime/container_status.json
USER_STREAM_HEALTH_PATH=/var/lib/binana-freqtrade-v101/shared/runtime/user_stream_health.json
BINANCE_REST_BASE=https://api.binance.com

TELEGRAM_REPORTS_ENABLED=false
TELEGRAM_MONITOR_BOT_TOKEN=replace_on_oracle_only
TELEGRAM_MONITOR_CHAT_ID=replace_on_oracle_only
MONITOR_URL=http://127.0.0.1:8090
